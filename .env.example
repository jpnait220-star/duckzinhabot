# Exemplo de variáveis privadas da hospedagem. Não coloque tokens verdadeiros neste arquivo.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
WEBSITE_URL=https://duckcommunity.go.altare.global

# Memória e configuração /duckzinha voice
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Respostas inteligentes: opcional
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=

# Voz em chamadas com Edge TTS online; não requer chave, cartão nem região.

# Buscas, opcional
TAVILY_API_KEY=
SERPER_API_KEY=

# Servidor e eventos, opcional
SUPPORT_PANEL_CHANNEL_ID=
WELCOME_CHANNEL_ID=
TICKET_CATEGORY_ID=
DELETE_AFTER_MINUTES=20

# Conversa espontânea em canais públicos (não exige @Duckzinha).
AUTO_CHAT_ENABLED=true
# Vazio = todos os canais públicos permitidos; ou IDs separados por vírgula.
AUTO_CHAT_CHANNEL_IDS=
AUTO_CHAT_INTERVAL_SECONDS=20
