# Exemplo de variáveis privadas da hospedagem. Não coloque tokens verdadeiros neste arquivo.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
WEBSITE_URL=https://duckzincommunity.vercel.app

# Memória e configuração /duckzinha voice
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Respostas inteligentes: opcional
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=

# Voz própria para as calls (recurso Azure Speech configurado pelo titular da conta).
# Sem as duas variáveis, os comandos de voz podem ser selecionados, mas não há áudio.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Buscas, opcional
TAVILY_API_KEY=
SERPER_API_KEY=

# Servidor e eventos, opcional
SUPPORT_PANEL_CHANNEL_ID=
WELCOME_CHANNEL_ID=
TICKET_CATEGORY_ID=
DELETE_AFTER_MINUTES=20
